<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1080.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.PrazoPagamentoController">

    <!-- CABEÇALHO / BARRA SUPERIOR -->
    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </BorderPane.margin>

                    <Button fx:id="btnVoltar"
                            onAction="#onVoltar"
                            prefWidth="90.0"
                            text="Voltar" />

                    <Label text="Prazos de Pagamento">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets right="20.0" />
                    </BorderPane.margin>

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- FORMULÁRIO -->
            <VBox prefWidth="390.0"
                  spacing="15.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <Label text="Dados do Prazo">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="135.0" prefWidth="135.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" />
                        <RowConstraints minHeight="30.0" />
                    </rowConstraints>

                    <Label text="Descrição:*" />
                    <TextField fx:id="txtDescricao"
                               promptText="Ex: 30 Dias"
                               GridPane.columnIndex="1" />

                    <Label text="Quantidade de dias:*" GridPane.rowIndex="1" />
                    <TextField fx:id="txtQuantidadeDias"
                               promptText="Ex: 30"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />
                </GridPane>

                <Label text="O status é controlado pelos botões Ativar e Desativar."
                       textFill="#555555"
                       wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="10.0">
                    <Button onAction="#acaoNovo"
                            prefHeight="35.0"
                            prefWidth="95.0"
                            text="Novo" />

                    <Button fx:id="btnSalvar"
                            defaultButton="true"
                            onAction="#acaoSalvar"
                            prefHeight="35.0"
                            prefWidth="95.0"
                            text="Salvar" />

                    <Button cancelButton="true"
                            onAction="#acaoCancelar"
                            prefHeight="35.0"
                            prefWidth="95.0"
                            text="Cancelar" />
                </HBox>
            </VBox>

            <!-- LISTAGEM ADMINISTRATIVA -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnAtivar"
                            disable="true"
                            onAction="#acaoAtivar"
                            prefHeight="35.0"
                            prefWidth="105.0"
                            text="Ativar" />

                    <Button fx:id="btnDesativar"
                            disable="true"
                            onAction="#acaoDesativar"
                            prefHeight="35.0"
                            prefWidth="105.0"
                            text="Desativar" />
                </HBox>

                <VBox spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5;"
                      VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>

                    <Label text="Lista de Prazos de Pagamento">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <TableView fx:id="tabelaPrazos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="65.0" text="ID" />
                            <TableColumn fx:id="colDescricao" prefWidth="280.0" text="Descrição" />
                            <TableColumn fx:id="colDias" prefWidth="100.0" text="Dias" />
                            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                        </columns>

                        <placeholder>
                            <Label text="Nenhum prazo de pagamento cadastrado." />
                        </placeholder>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Label fx:id="lblTotalPrazos"
                               text="Total: 0 prazos"
                               textFill="#555555" />
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
