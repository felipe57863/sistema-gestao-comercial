<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.RelatorioEntradaEstoqueController"
            prefWidth="1180.0"
            prefHeight="800.0"
            stylesheets="@TelaPrincipal.css"
            style="-fx-background-color: #f4f6f9;"
            styleClass="tela-principal">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;"
                    styleClass="cabecalho-principal">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar"
                            text="Voltar"
                            prefWidth="90.0"
                            onAction="#onVoltar" />
                    <Label text="Relatório de Entradas de Estoque"
                           styleClass="titulo-sistema" />
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT"
                      spacing="8.0"
                      styleClass="identificacao-cabecalho">
                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           styleClass="texto-cabecalho" />
                    <Label text="|" styleClass="separador-cabecalho" />
                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           styleClass="texto-cabecalho" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox spacing="12.0" style="-fx-background-color: #f4f6f9;">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0" />
            </padding>

            <VBox spacing="10.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">
                <Label text="Filtros" styleClass="cartao-titulo" />

                <GridPane hgap="10.0" vgap="6.0" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.0" />
                        <ColumnConstraints percentWidth="14.0" />
                        <ColumnConstraints percentWidth="12.0" />
                        <ColumnConstraints percentWidth="20.0" />
                        <ColumnConstraints percentWidth="22.0" />
                        <ColumnConstraints percentWidth="18.0" />
                    </columnConstraints>

                    <Label text="Data Inicial:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />
                    <Label text="Data Final:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />
                    <Label text="Número:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0" />
                    <Label text="Responsável:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0" />
                    <Label text="Produto:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="4"
                           GridPane.rowIndex="0" />
                    <Label text="Referência:"
                           styleClass="rotulo-periodo"
                           GridPane.columnIndex="5"
                           GridPane.rowIndex="0" />

                    <DatePicker fx:id="dpDataInicial"
                                maxWidth="Infinity"
                                prefHeight="34.0"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1" />
                    <DatePicker fx:id="dpDataFinal"
                                maxWidth="Infinity"
                                prefHeight="34.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />
                    <TextField fx:id="txtNumeroEntrada"
                               promptText="ID"
                               maxWidth="Infinity"
                               prefHeight="34.0"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1" />
                    <ComboBox fx:id="cbResponsavel"
                              maxWidth="Infinity"
                              prefHeight="34.0"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="1" />
                    <ComboBox fx:id="cbProduto"
                              maxWidth="Infinity"
                              prefHeight="34.0"
                              GridPane.columnIndex="4"
                              GridPane.rowIndex="1" />
                    <TextField fx:id="txtReferencia"
                               promptText="Contém..."
                               maxWidth="Infinity"
                               prefHeight="34.0"
                               GridPane.columnIndex="5"
                               GridPane.rowIndex="1" />
                </GridPane>

                <HBox alignment="CENTER_LEFT" minHeight="35.0" spacing="10.0">
                    <StackPane minWidth="28.0"
                               prefWidth="28.0"
                               maxWidth="28.0"
                               minHeight="28.0"
                               prefHeight="28.0"
                               maxHeight="28.0">
                        <ProgressIndicator fx:id="progressoRelatorio"
                                           visible="false"
                                           managed="false"
                                           prefWidth="22.0"
                                           prefHeight="22.0"
                                           styleClass="indicador-carregamento" />
                    </StackPane>
                    <Label fx:id="lblEstadoConsulta"
                           text="Relatório pronto para consulta."
                           wrapText="true"
                           styleClass="cartao-texto-secundario" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimparFiltros"
                            text="Limpar Filtros"
                            prefHeight="35.0"
                            prefWidth="125.0"
                            onAction="#onLimparFiltros" />
                    <Button fx:id="btnFiltrar"
                            text="Filtrar"
                            prefHeight="35.0"
                            prefWidth="100.0"
                            onAction="#onFiltrar"
                            styleClass="botao-atualizar" />
                </HBox>
            </VBox>

            <VBox spacing="7.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 12;">
                <Label text="Entradas encontradas" styleClass="cartao-titulo" />
                <TableView fx:id="tabelaEntradas"
                           minHeight="180.0"
                           maxWidth="Infinity"
                           maxHeight="Infinity"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero"
                                     text="Número"
                                     prefWidth="80.0"
                                     sortable="false" />
                        <TableColumn fx:id="colDataHoraEntrada"
                                     text="Data/Hora"
                                     prefWidth="155.0"
                                     sortable="false" />
                        <TableColumn fx:id="colResponsavel"
                                     text="Responsável"
                                     prefWidth="220.0"
                                     sortable="false" />
                        <TableColumn fx:id="colReferencia"
                                     text="Referência"
                                     prefWidth="190.0"
                                     sortable="false" />
                        <TableColumn fx:id="colProdutos"
                                     text="Produtos"
                                     prefWidth="90.0"
                                     sortable="false" />
                        <TableColumn fx:id="colUnidades"
                                     text="Unidades"
                                     prefWidth="90.0"
                                     sortable="false" />
                        <TableColumn fx:id="colValorTotal"
                                     text="Valor Total"
                                     prefWidth="130.0"
                                     sortable="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblFiltroAplicado"
                       text=""
                       wrapText="true"
                       styleClass="cartao-texto-secundario" />
            </VBox>

            <GridPane hgap="12.0" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.333" />
                    <ColumnConstraints percentWidth="33.333" />
                    <ColumnConstraints percentWidth="33.334" />
                </columnConstraints>

                <VBox spacing="3.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14;"
                      GridPane.columnIndex="0">
                    <Label text="Entradas" styleClass="cartao-texto-secundario" />
                    <Label fx:id="lblQuantidadeEntradas"
                           text="0 entradas"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>
                <VBox spacing="3.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14;"
                      GridPane.columnIndex="1">
                    <Label text="Unidades" styleClass="cartao-texto-secundario" />
                    <Label fx:id="lblTotalUnidades"
                           text="0 unidades"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>
                <VBox spacing="3.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14;"
                      GridPane.columnIndex="2">
                    <Label text="Valor Total" styleClass="cartao-texto-secundario" />
                    <Label fx:id="lblValorTotal"
                           text="R$ 0,00"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>
            </GridPane>

            <VBox spacing="7.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 12;">
                <Label text="Detalhes da Entrada" styleClass="cartao-titulo" />
                <HBox spacing="6.0">
                    <Label text="Observação:"
                           style="-fx-font-weight: bold; -fx-text-fill: #344253;" />
                    <Label fx:id="lblObservacao"
                           text="Selecione uma entrada para visualizar a observação."
                           wrapText="true"
                           HBox.hgrow="ALWAYS"
                           styleClass="cartao-texto-secundario" />
                </HBox>
                <TableView fx:id="tabelaItens"
                           minHeight="130.0"
                           prefHeight="150.0"
                           maxWidth="Infinity">
                    <columns>
                        <TableColumn fx:id="colProdutoDetalhe"
                                     text="Produto"
                                     prefWidth="430.0"
                                     sortable="false" />
                        <TableColumn fx:id="colQuantidadeDetalhe"
                                     text="Quantidade"
                                     prefWidth="130.0"
                                     sortable="false" />
                        <TableColumn fx:id="colPrecoCompraDetalhe"
                                     text="Preço de Compra"
                                     prefWidth="170.0"
                                     sortable="false" />
                        <TableColumn fx:id="colSubtotalDetalhe"
                                     text="Subtotal"
                                     prefWidth="170.0"
                                     sortable="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
