<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="15.0"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.luis.controller.LoginController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label text="Sistema de Gestão Comercial">
        <font>
            <Font name="System Bold" size="22.0"/>
        </font>
        <VBox.margin>
            <Insets bottom="20.0"/>
        </VBox.margin>
    </Label>

    <VBox spacing="5.0">
        <Label text="Login:"/>
        <TextField fx:id="txtLogin"
                   promptText="Digite seu usuário"
                   style="-fx-padding: 8;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Senha:"/>
        <PasswordField fx:id="txtSenha"
                       promptText="Digite sua senha"
                       style="-fx-padding: 8;"/>
    </VBox>

    <Label fx:id="lblMensagem" textFill="red"/>

    <Button fx:id="btnEntrar"
            text="ENTRAR"
            maxWidth="Infinity"
            defaultButton="true"
            onAction="#fazerLogin"
            style="-fx-background-color: #2c7be5; -fx-text-fill: white;">
        <VBox.margin>
            <Insets top="15.0"/>
        </VBox.margin>
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Button>

</VBox>