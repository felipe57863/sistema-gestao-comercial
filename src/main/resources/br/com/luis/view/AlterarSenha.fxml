<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0"
           prefWidth="500.0"
           style="-fx-background-color: #e9ecef;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.luis.controller.AlterarSenhaController">

    <VBox alignment="CENTER"
          maxHeight="520.0"
          maxWidth="460.0"
          spacing="15.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">

        <padding>
            <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
        </padding>

        <Label text="Alterar Senha"
               textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Usuário:" />
            <Label fx:id="lblUsuario"
                   maxWidth="Infinity"
                   style="-fx-font-weight: bold; -fx-padding: 8; -fx-background-color: #f4f6f9;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Senha atual:" />
            <PasswordField fx:id="txtSenhaAtual"
                           promptText="Digite a senha atual"
                           style="-fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Nova senha:" />
            <PasswordField fx:id="txtNovaSenha"
                           promptText="Digite a nova senha"
                           style="-fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Confirmação:" />
            <PasswordField fx:id="txtConfirmacaoSenha"
                           promptText="Digite novamente a nova senha"
                           style="-fx-padding: 8;" />
        </VBox>

        <Label text="A nova senha deve possuir pelo menos 8 caracteres."
               wrapText="true"
               style="-fx-text-fill: #5f6b7a;" />

        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="btnCancelar"
                    cancelButton="true"
                    onAction="#cancelar"
                    prefWidth="150.0"
                    text="CANCELAR" />

            <Button fx:id="btnAlterarSenha"
                    defaultButton="true"
                    onAction="#alterarSenha"
                    prefWidth="150.0"
                    style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                    text="ALTERAR SENHA" />
        </HBox>
    </VBox>
</StackPane>
