<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #e9ecef;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.luis.controller.ConfiguracaoInicialController">

    <VBox alignment="CENTER"
          maxHeight="560.0"
          maxWidth="460.0"
          spacing="15.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label text="Configuração Inicial"
               textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label text="Defina a senha do administrador do sistema."
               textAlignment="CENTER"
               wrapText="true" />

        <VBox spacing="5.0">
            <Label text="Nome:" />
            <Label fx:id="lblNomeAdministrador"
                   maxWidth="Infinity"
                   style="-fx-font-weight: bold; -fx-padding: 8; -fx-background-color: #f4f6f9;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Login:" />
            <Label fx:id="lblLoginAdministrador"
                   maxWidth="Infinity"
                   style="-fx-font-weight: bold; -fx-padding: 8; -fx-background-color: #f4f6f9;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Nova senha:" />
            <PasswordField fx:id="txtNovaSenha"
                           promptText="Digite a senha definitiva"
                           style="-fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Confirmar senha:" />
            <PasswordField fx:id="txtConfirmacaoSenha"
                           promptText="Digite novamente a senha"
                           style="-fx-padding: 8;" />
        </VBox>

        <Label text="A senha deve possuir no mínimo 8 caracteres."
               wrapText="true"
               style="-fx-text-fill: #5f6b7a;" />

        <Button fx:id="btnConfigurarAdministrador"
                defaultButton="true"
                maxWidth="Infinity"
                onAction="#configurarAdministrador"
                style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                text="CONFIGURAR ADMINISTRADOR">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </VBox>
</StackPane>
