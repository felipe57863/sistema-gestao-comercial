<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.luis.controller.RegistroVendaController"
            prefWidth="1180"
            prefHeight="720"
            style="-fx-background-color: #f5f5f5;">

    <!-- =========================================================
         CABEÇALHO
         ========================================================= -->
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER"
                  prefHeight="48"
                  style="-fx-border-color: #666666; -fx-border-width: 0 0 1 0; -fx-background-color: #eeeeee;">
                <Label text="Sistema de Gestão Comercial">
                    <font>
                        <Font size="20"/>
                    </font>
                </Label>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  prefHeight="58"
                  spacing="20"
                  style="-fx-border-color: #666666; -fx-border-width: 0 0 1 0; -fx-background-color: white;">
                <padding>
                    <Insets top="0" right="24" bottom="0" left="24"/>
                </padding>

                <Label fx:id="lblTituloTela" text="Registro de Venda">
                    <font>
                        <Font size="20"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblUsuarioLogado" text="Usuário: Vendedor |"/>
                <Label fx:id="lblDataHora" text="12/04/2024 15:45"/>
            </HBox>
        </VBox>
    </top>

    <!-- =========================================================
         CONTEÚDO PRINCIPAL
         ========================================================= -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <!-- =================================================
                 ÁREA ESQUERDA — PRODUTOS, CARRINHO, DESCONTO
                 ================================================= -->
            <VBox spacing="16" HBox.hgrow="ALWAYS">

                <!-- Área de busca/adicionar produto -->
                <VBox spacing="12"
                      style="-fx-border-color: #777777; -fx-border-width: 1; -fx-background-color: white;">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar produto (nome ou código):"/>

                        <TextField fx:id="txtBuscaProduto"
                                   promptText="Digite o nome ou código"
                                   prefWidth="280"/>

                        <Label text="Qtd:"/>

                        <Spinner fx:id="spnQuantidadeProduto"
                                 editable="true"
                                 prefWidth="90"/>

                        <Button fx:id="btnAdicionarProduto"
                                text="Adicionar"
                                prefWidth="120"
                                onAction="#onAdicionarProduto"/>
                    </HBox>

                    <TableView fx:id="tblItensVenda"
                               prefHeight="260"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProduto"
                                         text="Produto"
                                         prefWidth="230"/>
                            <TableColumn fx:id="colPreco"
                                         text="Preço"
                                         prefWidth="120"/>
                            <TableColumn fx:id="colPromocao"
                                         text="Promoção"
                                         prefWidth="150"/>
                            <TableColumn fx:id="colQuantidade"
                                         text="Quantidade"
                                         prefWidth="130"/>
                            <TableColumn fx:id="colSubtotal"
                                         text="Subtotal"
                                         prefWidth="140"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button fx:id="btnRemoverProduto"
                                text="Remover Produto"
                                prefWidth="180"
                                onAction="#onRemoverProduto"/>

                        <Button fx:id="btnLimparVenda"
                                text="Limpar Venda"
                                prefWidth="160"
                                onAction="#onLimparVenda"/>
                    </HBox>
                </VBox>

                <!-- Área de desconto global -->
                <VBox spacing="12">
                    <Separator/>

                    <Label text="Desconto:">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <RadioButton fx:id="rbDescontoValor" text="Valor R$">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgTipoDescontoGlobal"/>
                            </toggleGroup>
                        </RadioButton>

                        <TextField fx:id="txtDescontoValor"
                                   promptText="0,00"
                                   prefWidth="110"/>

                        <RadioButton fx:id="rbDescontoPercentual"
                                     text="Percentual %"
                                     toggleGroup="$tgTipoDescontoGlobal"/>

                        <TextField fx:id="txtDescontoPercentual"
                                   promptText="0"
                                   prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER">
                        <Button fx:id="btnAplicarDesconto"
                                text="Aplicar Desconto"
                                prefWidth="190"/>
                    </HBox>
                </VBox>

                <!-- Tipo de venda -->
                <VBox spacing="12">
                    <Separator/>

                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <Label text="Tipo de Venda:">
                            <font>
                                <Font size="17"/>
                            </font>
                        </Label>

                        <RadioButton fx:id="rbVendaAVista" text="À Vista">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgTipoVenda"/>
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="rbVendaAPrazo"
                                     text="A Prazo"
                                     toggleGroup="$tgTipoVenda"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- =================================================
                 ÁREA DIREITA — CLIENTE E RESUMO
                 ================================================= -->
            <VBox spacing="16" prefWidth="400">

                <!-- Área de cliente -->
                <VBox spacing="12"
                      style="-fx-border-color: #777777; -fx-border-width: 1; -fx-background-color: white;">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>

                    <Label text="Cliente:">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBuscaCliente"
                                   promptText="Buscar cliente"
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnSelecionarCliente"
                                text="Selecionar"
                                prefWidth="110"/>
                    </HBox>

                    <GridPane hgap="10" vgap="12">
                        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblNomeCliente"
                               text="-"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblStatusCliente"
                               text="-"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Limite disponível:"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>
                        <Label fx:id="lblLimiteDisponivel"
                               text="R$ 0,00"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Resumo da venda -->
                <VBox spacing="14"
                      style="-fx-border-color: #777777; -fx-border-width: 1; -fx-background-color: white;">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>

                    <Label text="Resumo da Venda:">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <Separator/>

                    <GridPane hgap="10" vgap="14">
                        <Label text="Subtotal:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>
                        <Label fx:id="lblSubtotalVenda"
                               text="R$ 0,00"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                        <Label text="Desconto:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>
                        <Label fx:id="lblDescontoGlobal"
                               text="R$ 0,00"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                        <Label text="Total:"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0">
                            <font>
                                <Font size="20"/>
                            </font>
                        </Label>

                        <Label fx:id="lblTotalVenda"
                               text="R$ 0,00"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1">
                            <font>
                                <Font size="22"/>
                            </font>
                        </Label>
                    </GridPane>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <!-- =========================================================
         RODAPÉ — BOTÕES FINAIS
         ========================================================= -->
    <bottom>
        <HBox spacing="16"
              alignment="CENTER_LEFT"
              prefHeight="82"
              style="-fx-border-color: #666666; -fx-border-width: 1 0 0 0; -fx-background-color: white;">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>

            <Button fx:id="btnFinalizarVenda"
                    text="Finalizar Venda"
                    prefWidth="230"
                    prefHeight="44"
                    style="-fx-font-size: 18px;"/>

            <Button fx:id="btnCancelarVenda"
                    text="Cancelar"
                    prefWidth="150"
                    prefHeight="44"
                    style="-fx-font-size: 16px;"/>
        </HBox>
    </bottom>

</BorderPane>