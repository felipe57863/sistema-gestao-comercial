<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1180.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.luis.controller.RegistroVendaController">

    <!-- =========================================================
         CABEÇALHO
         ========================================================= -->
    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar"
                            onAction="#onVoltar"
                            prefWidth="90.0"
                            text="Voltar" />

                    <Label fx:id="lblTituloTela" text="Registro de Venda">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label fx:id="lblUsuarioLogado"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- =========================================================
         CONTEÚDO PRINCIPAL
         ========================================================= -->
    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- =================================================
                 COLUNA ESQUERDA — PRODUTOS, DESCONTO E TIPO
                 ================================================= -->
            <VBox maxWidth="Infinity"
                  minWidth="560.0"
                  spacing="14.0"
                  HBox.hgrow="ALWAYS">

                <!-- Produtos e carrinho -->
                <VBox maxHeight="Infinity"
                      maxWidth="Infinity"
                      spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 16;"
                      VBox.vgrow="ALWAYS">

                    <Label text="Produtos">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <VBox spacing="7.0">
                        <Label text="Código ou descrição:" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <TextField fx:id="txtBuscaProduto"
                                       maxWidth="Infinity"
                                       prefHeight="34.0"
                                       promptText="Digite o ID ou a descrição"
                                       HBox.hgrow="ALWAYS">
                                <tooltip>
                                    <Tooltip text="Busca por ID adiciona direto. Busca por descrição pode abrir a seleção." />
                                </tooltip>
                            </TextField>

                            <Button fx:id="btnAdicionarProduto"
                                    onAction="#onAdicionarProduto"
                                    prefHeight="35.0"
                                    prefWidth="110.0"
                                    text="Buscar">
                                <tooltip>
                                    <Tooltip text="Busca por ID adiciona direto. Busca por descrição pode abrir a seleção." />
                                </tooltip>
                            </Button>
                        </HBox>
                    </VBox>

                    <TableView fx:id="tblItensVenda"
                               maxHeight="Infinity"
                               maxWidth="Infinity"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colProduto"
                                         minWidth="160.0"
                                         prefWidth="230.0"
                                         text="Produto" />
                            <TableColumn fx:id="colPreco"
                                         minWidth="85.0"
                                         prefWidth="120.0"
                                         text="Preço" />
                            <TableColumn fx:id="colPromocao"
                                         minWidth="100.0"
                                         prefWidth="150.0"
                                         text="Promoção" />
                            <TableColumn fx:id="colQuantidade"
                                         minWidth="100.0"
                                         prefWidth="130.0"
                                         text="Quantidade" />
                            <TableColumn fx:id="colSubtotal"
                                         minWidth="105.0"
                                         prefWidth="140.0"
                                         text="Subtotal" />
                        </columns>

                        <placeholder>
                            <Label text="Nenhum produto adicionado à venda." />
                        </placeholder>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button fx:id="btnRemoverProduto"
                                disable="true"
                                onAction="#onRemoverProduto"
                                prefHeight="35.0"
                                prefWidth="170.0"
                                text="Remover Produto" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnLimparVenda"
                                disable="true"
                                onAction="#onLimparVenda"
                                prefHeight="35.0"
                                prefWidth="145.0"
                                text="Limpar Venda" />
                    </HBox>
                </VBox>

                <!-- Desconto global -->
                <VBox maxWidth="Infinity"
                      spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;">

                    <Label text="Desconto">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <GridPane alignment="CENTER_LEFT"
                              hgap="10.0"
                              maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints minWidth="76.0" />
                            <ColumnConstraints minWidth="100.0" prefWidth="100.0" />
                            <ColumnConstraints minWidth="104.0" />
                            <ColumnConstraints minWidth="80.0" prefWidth="80.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                            <ColumnConstraints minWidth="150.0" prefWidth="150.0" />
                        </columnConstraints>

                        <RadioButton fx:id="rbDescontoValor"
                                     text="Valor R$"
                                     GridPane.columnIndex="0">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgTipoDescontoGlobal" />
                            </toggleGroup>
                        </RadioButton>

                        <TextField fx:id="txtDescontoValor"
                                   maxWidth="Infinity"
                                   prefHeight="34.0"
                                   promptText="0,00"
                                   GridPane.columnIndex="1" />

                        <RadioButton fx:id="rbDescontoPercentual"
                                     text="Percentual %"
                                     toggleGroup="$tgTipoDescontoGlobal"
                                     GridPane.columnIndex="2" />

                        <TextField fx:id="txtDescontoPercentual"
                                   maxWidth="Infinity"
                                   prefHeight="34.0"
                                   promptText="0"
                                   GridPane.columnIndex="3" />

                        <Region GridPane.columnIndex="4" />

                        <Button fx:id="btnAplicarDesconto"
                                disable="true"
                                onAction="#onAplicarDesconto"
                                prefHeight="35.0"
                                prefWidth="150.0"
                                text="Aplicar Desconto"
                                GridPane.columnIndex="5" />
                    </GridPane>
                </VBox>

                <!-- Tipo de venda -->
                <VBox maxWidth="Infinity"
                      spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;">

                    <Label text="Tipo de Venda">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <HBox alignment="CENTER_LEFT" spacing="28.0">
                        <RadioButton fx:id="rbVendaAVista" text="À Vista">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgTipoVenda" />
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="rbVendaAPrazo"
                                     text="A Prazo"
                                     toggleGroup="$tgTipoVenda" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- =================================================
                 COLUNA DIREITA — CLIENTE E RESUMO
                 ================================================= -->
            <VBox maxWidth="400.0"
                  minWidth="330.0"
                  prefWidth="370.0"
                  spacing="14.0">

                <!-- Cliente -->
                <VBox maxWidth="Infinity"
                      spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 16;">

                    <Label text="Cliente">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="txtBuscaCliente"
                                   maxWidth="Infinity"
                                   prefHeight="34.0"
                                   promptText="Buscar cliente"
                                   HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnSelecionarCliente"
                                onAction="#onSelecionarCliente"
                                prefHeight="35.0"
                                prefWidth="110.0"
                                text="Selecionar" />
                    </HBox>

                    <GridPane hgap="12.0" vgap="11.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="115.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Nome:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />
                        <Label fx:id="lblNomeCliente"
                               maxWidth="Infinity"
                               text="-"
                               wrapText="true"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0" />

                        <Label text="Status:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />
                        <Label fx:id="lblStatusCliente"
                               text="-"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                        <Label text="Limite disponível:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2" />
                        <Label fx:id="lblLimiteDisponivel"
                               text="R$ 0,00"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2" />
                    </GridPane>
                </VBox>

                <!-- Resumo da venda -->
                <VBox maxWidth="Infinity"
                      spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 16;">

                    <Label text="Resumo da Venda">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <GridPane hgap="12.0" vgap="13.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" />
                            <ColumnConstraints minWidth="120.0" />
                        </columnConstraints>

                        <Label text="Subtotal"
                               textFill="#555555"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0" />
                        <Label fx:id="lblSubtotalVenda"
                               text="R$ 0,00"
                               GridPane.columnIndex="1"
                               GridPane.halignment="RIGHT"
                               GridPane.rowIndex="0" />

                        <Label text="Desconto"
                               textFill="#555555"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1" />
                        <Label fx:id="lblDescontoGlobal"
                               text="R$ 0,00"
                               GridPane.columnIndex="1"
                               GridPane.halignment="RIGHT"
                               GridPane.rowIndex="1" />

                        <Separator GridPane.columnIndex="0"
                                   GridPane.columnSpan="2"
                                   GridPane.rowIndex="2" />

                        <Label text="TOTAL"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>

                        <Label fx:id="lblTotalVenda"
                               text="R$ 0,00"
                               textFill="#344253"
                               GridPane.columnIndex="1"
                               GridPane.halignment="RIGHT"
                               GridPane.rowIndex="3">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </GridPane>
                </VBox>

            </VBox>
        </HBox>
    </center>

    <!-- =========================================================
         BARRA GERAL DE AÇÕES
         ========================================================= -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              maxWidth="Infinity"
              spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
            </BorderPane.margin>

            <Button fx:id="btnFinalizarVenda"
                    disable="true"
                    onAction="#onFinalizarVenda"
                    prefHeight="40.0"
                    prefWidth="170.0"
                    style="-fx-background-color: #345f86; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"
                    text="Finalizar Venda" />

            <Button fx:id="btnCancelarVenda"
                    onAction="#onCancelarVenda"
                    prefHeight="40.0"
                    prefWidth="130.0"
                    text="Cancelar" />
        </HBox>
    </bottom>
</BorderPane>
