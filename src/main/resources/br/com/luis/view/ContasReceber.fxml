<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1180.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.ContasReceberController">

    <!-- =========================================================
         CABEÇALHO
         ========================================================= -->
    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar" onAction="#onVoltar" prefWidth="90.0" text="Voltar" />
                    <Label text="Contas a Receber">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label fx:id="lblUsuario" text="Usuário não identificado" textFill="#555555" />
                    <Label text="|" textFill="#777777" />
                    <Label fx:id="lblDataHora" text="--/--/---- --:--:--" textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- =================================================
                 PAINEL DA CONTA SELECIONADA
                 ================================================= -->
            <VBox prefWidth="350.0"
                  spacing="16.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 20;">

                <Label text="Conta Selecionada">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                    <Label text="ID da conta:" GridPane.rowIndex="0" />
                    <Label fx:id="lblContaId" text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Cliente:" GridPane.rowIndex="1" />
                    <Label fx:id="lblCliente" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Venda:" GridPane.rowIndex="2" />
                    <Label fx:id="lblVendaId" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Valor:" GridPane.rowIndex="3" />
                    <Label fx:id="lblValor" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Vencimento:" GridPane.rowIndex="4" />
                    <Label fx:id="lblVencimento" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Status:" GridPane.rowIndex="5" />
                    <Label fx:id="lblStatus" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label text="Situação:" GridPane.rowIndex="6" />
                    <Label fx:id="lblSituacao" text="—" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                </GridPane>

                <VBox spacing="8.0"
                      style="-fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 15;">
                    <Label text="Selecione uma conta na tabela para visualizar os detalhes."
                           wrapText="true" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="btnReceberConta"
                            disable="true"
                            onAction="#onReceberConta"
                            prefHeight="35.0"
                            prefWidth="150.0"
                            text="Receber Conta" />
                </HBox>
            </VBox>

            <!-- =================================================
                 PAINEL DE CONTAS PENDENTES
                 ================================================= -->
            <VBox spacing="15.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 20;"
                  HBox.hgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Contas Pendentes">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnAtualizar"
                            onAction="#onAtualizar"
                            prefHeight="35.0"
                            prefWidth="120.0"
                            text="Atualizar" />
                </HBox>

                <TableView fx:id="tabelaContasPendentes"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colConta" prefWidth="80.0" text="Conta" />
                        <TableColumn fx:id="colCliente" prefWidth="260.0" text="Cliente" />
                        <TableColumn fx:id="colVenda" prefWidth="90.0" text="Venda" />
                        <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor" />
                        <TableColumn fx:id="colVencimento" prefWidth="140.0" text="Vencimento" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                        <TableColumn fx:id="colSituacao" prefWidth="140.0" text="Situação" />
                    </columns>

                    <placeholder>
                        <Label text="Nenhuma conta pendente encontrada." />
                    </placeholder>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER">
                    <Label fx:id="lblTotalContas"
                           text="Total: 0 contas pendentes"
                           textFill="#555555" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
