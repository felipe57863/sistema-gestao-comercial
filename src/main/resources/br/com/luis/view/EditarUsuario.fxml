<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      prefHeight="420.0"
      prefWidth="560.0"
      spacing="18.0"
      style="-fx-background-color: #f4f6f9; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.luis.controller.EditarUsuarioController">

    <Label text="Editar usuário">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox maxWidth="500.0"
          spacing="16.0"
          style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 22;">

        <GridPane hgap="12.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints minWidth="145.0" />
                <ColumnConstraints hgrow="ALWAYS"
                                   minWidth="280.0" />
            </columnConstraints>

            <Label text="Nome:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0" />
            <TextField fx:id="txtNome"
                       maxWidth="Infinity"
                       prefHeight="34.0"
                       promptText="Nome completo"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0" />

            <Label text="Login:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1" />
            <TextField fx:id="txtLogin"
                       maxWidth="Infinity"
                       prefHeight="34.0"
                       promptText="Login de acesso"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1" />

            <Label text="Perfil:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbPerfil"
                      maxWidth="Infinity"
                      prefHeight="34.0"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="2" />

            <Label text="Status:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3" />
            <Label fx:id="lblStatus"
                   style="-fx-font-weight: bold;"
                   text="-"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3" />

            <Label text="Troca obrigatória:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="4" />
            <Label fx:id="lblTrocaObrigatoria"
                   style="-fx-font-weight: bold;"
                   text="-"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4" />
        </GridPane>

        <Label text="Senha, status e troca obrigatória são alterados somente pelos fluxos próprios."
               textFill="#666666"
               wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnCancelar"
                    cancelButton="true"
                    onAction="#cancelar"
                    prefHeight="35.0"
                    prefWidth="100.0"
                    text="Cancelar" />
            <Button fx:id="btnSalvar"
                    defaultButton="true"
                    disable="true"
                    onAction="#salvar"
                    prefHeight="35.0"
                    prefWidth="100.0"
                    text="Salvar" />
        </HBox>
    </VBox>
</VBox>
