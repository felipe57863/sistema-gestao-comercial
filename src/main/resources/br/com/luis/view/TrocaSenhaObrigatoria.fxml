<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #e9ecef;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.luis.controller.TrocaSenhaObrigatoriaController">

    <VBox alignment="CENTER" maxHeight="480.0" maxWidth="460.0" spacing="15.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label text="Troca Obrigatória de Senha"
               textAlignment="CENTER"
               wrapText="true">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label text="Defina uma nova senha antes de acessar normalmente o ERP."
               textAlignment="CENTER"
               wrapText="true" />

        <VBox spacing="5.0">
            <Label text="Usuário:" />
            <Label fx:id="lblUsuario"
                   style="-fx-font-weight: bold; -fx-padding: 8; -fx-background-color: #f4f6f9;"
                   maxWidth="Infinity" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Nova senha:" />
            <PasswordField fx:id="txtNovaSenha"
                           promptText="Digite a nova senha"
                           style="-fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Confirmação:" />
            <PasswordField fx:id="txtConfirmacaoSenha"
                           promptText="Digite novamente a nova senha"
                           style="-fx-padding: 8;" />
        </VBox>

        <Label text="A nova senha deve possuir pelo menos 8 caracteres."
               wrapText="true"
               style="-fx-text-fill: #5f6b7a;" />

        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="btnVoltar"
                    cancelButton="true"
                    onAction="#voltarAoLogin"
                    prefWidth="150.0"
                    text="VOLTAR AO LOGIN" />

            <Button fx:id="btnConfirmar"
                    defaultButton="true"
                    onAction="#confirmarTrocaSenha"
                    prefWidth="150.0"
                    style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                    text="CONFIRMAR" />
        </HBox>
    </VBox>
</StackPane>
