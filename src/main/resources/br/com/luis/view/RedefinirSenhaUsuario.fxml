<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="540.0"
           prefWidth="500.0"
           style="-fx-background-color: #e9ecef;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.luis.controller.RedefinirSenhaUsuarioController">

    <VBox alignment="CENTER"
          maxHeight="500.0"
          maxWidth="460.0"
          spacing="15.0"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);">

        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
        </padding>

        <Label text="Redefinir Senha" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <GridPane hgap="12.0"
                  vgap="10.0"
                  style="-fx-background-color: #f4f6f9; -fx-padding: 12;">
            <Label text="Login:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0" />
            <Label fx:id="lblLogin"
                   style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0" />

            <Label text="Perfil:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1" />
            <Label fx:id="lblPerfil"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1" />

            <Label text="Status:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2" />
            <Label fx:id="lblStatus"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2" />
        </GridPane>

        <VBox spacing="5.0">
            <Label text="Nova senha temporária:" />
            <PasswordField fx:id="txtSenhaTemporaria"
                           promptText="Mínimo de 8 caracteres"
                           style="-fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="Confirmação:" />
            <PasswordField fx:id="txtConfirmacao"
                           promptText="Repita a senha temporária"
                           style="-fx-padding: 8;" />
        </VBox>

        <Label text="A troca de senha será obrigatória no próximo acesso."
               wrapText="true"
               style="-fx-text-fill: #8a5a00; -fx-font-weight: bold;" />

        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="btnCancelar"
                    cancelButton="true"
                    onAction="#cancelar"
                    prefWidth="150.0"
                    text="Cancelar" />
            <Button fx:id="btnConfirmar"
                    defaultButton="true"
                    disable="true"
                    onAction="#confirmar"
                    prefWidth="150.0"
                    style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                    text="Confirmar" />
        </HBox>
    </VBox>
</StackPane>
