<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.RelatorioProdutoController"
            prefWidth="1180.0"
            prefHeight="720.0"
            stylesheets="@TelaPrincipal.css"
            style="-fx-background-color: #f4f6f9;"
            styleClass="tela-principal">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;"
                    styleClass="cabecalho-principal">

            <left>
                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <Button fx:id="btnVoltar"
                            text="Voltar"
                            prefWidth="90.0"
                            onAction="#onVoltar" />

                    <Label text="Relatório de Produtos"
                           styleClass="titulo-sistema" />
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT"
                      spacing="8.0"
                      styleClass="identificacao-cabecalho">

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           styleClass="texto-cabecalho" />

                    <Label text="|"
                           styleClass="separador-cabecalho" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           styleClass="texto-cabecalho" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox spacing="10.0"
              style="-fx-background-color: #f4f6f9;">

            <padding>
                <Insets top="14.0"
                        right="18.0"
                        bottom="16.0"
                        left="18.0" />
            </padding>

            <HBox alignment="CENTER_LEFT"
                  minHeight="30.0"
                  spacing="10.0">

                <StackPane minWidth="28.0"
                           prefWidth="28.0"
                           maxWidth="28.0"
                           minHeight="28.0"
                           prefHeight="28.0"
                           maxHeight="28.0"
                           styleClass="area-carregamento">

                    <ProgressIndicator fx:id="progressoRelatorio"
                                       visible="false"
                                       managed="false"
                                       prefWidth="22.0"
                                       prefHeight="22.0"
                                       styleClass="indicador-carregamento" />
                </StackPane>

                <Label fx:id="lblEstadoConsulta"
                       text="Relatório pronto para consulta."
                       wrapText="true"
                       styleClass="cartao-texto-secundario" />
            </HBox>

            <TabPane fx:id="tabPaneRelatorios"
                     tabClosingPolicy="UNAVAILABLE"
                     maxWidth="Infinity"
                     maxHeight="Infinity"
                     VBox.vgrow="ALWAYS">

                <tabs>
                    <Tab fx:id="tabEstoque"
                         text="Estoque">

                        <VBox spacing="12.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              style="-fx-background-color: #f4f6f9; -fx-padding: 14;">

                            <VBox spacing="9.0"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">

                                <Label text="Filtros de estoque"
                                       styleClass="cartao-titulo" />

                                <GridPane hgap="12.0"
                                          vgap="7.0"
                                          maxWidth="Infinity">

                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0"
                                                           hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="23.0"
                                                           hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="27.0"
                                                           hgrow="ALWAYS" />
                                    </columnConstraints>

                                    <Label text="Descrição:"
                                           GridPane.columnIndex="0"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <Label text="Status:"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <Label text="Situação:"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <TextField fx:id="txtDescricaoEstoque"
                                               promptText="Descrição parcial do produto"
                                               prefHeight="34.0"
                                               maxWidth="Infinity"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1" />

                                    <ComboBox fx:id="cbStatusEstoque"
                                              prefHeight="34.0"
                                              maxWidth="Infinity"
                                              styleClass="combo-periodo"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="1" />

                                    <ComboBox fx:id="cbSituacaoEstoque"
                                              prefHeight="34.0"
                                              maxWidth="Infinity"
                                              styleClass="combo-periodo"
                                              GridPane.columnIndex="2"
                                              GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox alignment="CENTER_RIGHT">
                                    <Button fx:id="btnFiltrarEstoque"
                                            text="Filtrar"
                                            disable="true"
                                            prefWidth="110.0"
                                            prefHeight="35.0"
                                            onAction="#onFiltrarEstoque"
                                            styleClass="botao-atualizar" />
                                </HBox>
                            </VBox>

                            <VBox spacing="8.0"
                                  maxWidth="Infinity"
                                  maxHeight="Infinity"
                                  VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">

                                <Label text="Produtos encontrados"
                                       styleClass="cartao-titulo" />

                                <TableView fx:id="tabelaEstoque"
                                           maxWidth="Infinity"
                                           maxHeight="Infinity"
                                           VBox.vgrow="ALWAYS">

                                    <columns>
                                        <TableColumn fx:id="colEstoqueProdutoId"
                                                     text="ID"
                                                     prefWidth="65.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueDescricao"
                                                     text="Produto"
                                                     prefWidth="300.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueAtual"
                                                     text="Estoque atual"
                                                     prefWidth="120.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueMinimo"
                                                     text="Estoque mínimo"
                                                     prefWidth="125.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueDiferenca"
                                                     text="Diferença"
                                                     prefWidth="100.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueSituacao"
                                                     text="Situação"
                                                     prefWidth="155.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colEstoqueStatus"
                                                     text="Status"
                                                     prefWidth="95.0"
                                                     sortable="false" />
                                    </columns>

                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <GridPane hgap="10.0"
                                      maxWidth="Infinity">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="25.0" />
                                    <ColumnConstraints percentWidth="25.0" />
                                    <ColumnConstraints percentWidth="25.0" />
                                    <ColumnConstraints percentWidth="25.0" />
                                </columnConstraints>

                                <VBox spacing="3.0"
                                      minHeight="58.0"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="0"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14 10 14;">

                                    <Label text="Produtos listados"
                                           styleClass="cartao-texto-secundario" />
                                    <Label fx:id="lblQuantidadeProdutos"
                                           text="0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                                </VBox>

                                <VBox spacing="3.0"
                                      minHeight="58.0"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="1"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14 10 14;">

                                    <Label text="Abaixo do mínimo"
                                           styleClass="cartao-texto-secundario" />
                                    <Label fx:id="lblQuantidadeAbaixo"
                                           text="0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                                </VBox>

                                <VBox spacing="3.0"
                                      minHeight="58.0"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="2"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14 10 14;">

                                    <Label text="No mínimo"
                                           styleClass="cartao-texto-secundario" />
                                    <Label fx:id="lblQuantidadeNoMinimo"
                                           text="0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                                </VBox>

                                <VBox spacing="3.0"
                                      minHeight="58.0"
                                      maxWidth="Infinity"
                                      GridPane.columnIndex="3"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14 10 14;">

                                    <Label text="Acima do mínimo"
                                           styleClass="cartao-texto-secundario" />
                                    <Label fx:id="lblQuantidadeAcima"
                                           text="0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                                </VBox>
                            </GridPane>
                        </VBox>
                    </Tab>

                    <Tab fx:id="tabPromocoes"
                         text="Em promoção">

                        <VBox spacing="12.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              style="-fx-background-color: #f4f6f9; -fx-padding: 14;">

                            <VBox spacing="9.0"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">

                                <Label text="Filtros de produtos em promoção"
                                       styleClass="cartao-titulo" />

                                <GridPane hgap="12.0"
                                          vgap="7.0"
                                          maxWidth="Infinity">

                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0"
                                                           hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="23.0"
                                                           hgrow="ALWAYS" />
                                        <ColumnConstraints percentWidth="27.0"
                                                           hgrow="ALWAYS" />
                                    </columnConstraints>

                                    <Label text="Descrição:"
                                           GridPane.columnIndex="0"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <Label text="Status do produto:"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <Label text="Tipo de desconto:"
                                           GridPane.columnIndex="2"
                                           GridPane.rowIndex="0"
                                           styleClass="rotulo-periodo" />

                                    <TextField fx:id="txtDescricaoPromocao"
                                               promptText="Descrição parcial do produto"
                                               prefHeight="34.0"
                                               maxWidth="Infinity"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1" />

                                    <ComboBox fx:id="cbStatusPromocao"
                                              prefHeight="34.0"
                                              maxWidth="Infinity"
                                              styleClass="combo-periodo"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="1" />

                                    <ComboBox fx:id="cbTipoDesconto"
                                              prefHeight="34.0"
                                              maxWidth="Infinity"
                                              styleClass="combo-periodo"
                                              GridPane.columnIndex="2"
                                              GridPane.rowIndex="1" />
                                </GridPane>

                                <HBox alignment="CENTER_RIGHT">
                                    <Button fx:id="btnFiltrarPromocoes"
                                            text="Filtrar"
                                            disable="true"
                                            prefWidth="110.0"
                                            prefHeight="35.0"
                                            onAction="#onFiltrarPromocoes"
                                            styleClass="botao-atualizar" />
                                </HBox>
                            </VBox>

                            <VBox spacing="8.0"
                                  maxWidth="Infinity"
                                  maxHeight="Infinity"
                                  VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">

                                <Label text="Promoções encontradas"
                                       styleClass="cartao-titulo" />

                                <TableView fx:id="tabelaPromocoes"
                                           maxWidth="Infinity"
                                           maxHeight="Infinity"
                                           VBox.vgrow="ALWAYS">

                                    <columns>
                                        <TableColumn fx:id="colPromocaoProdutoId"
                                                     text="ID Produto"
                                                     prefWidth="90.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colPromocaoDescricao"
                                                     text="Produto"
                                                     prefWidth="330.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colPromocaoPrecoNormal"
                                                     text="Preço normal"
                                                     prefWidth="135.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colPromocaoTipoDesconto"
                                                     text="Tipo de desconto"
                                                     prefWidth="150.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colPromocaoValorDesconto"
                                                     text="Valor do desconto"
                                                     prefWidth="145.0"
                                                     sortable="false" />

                                        <TableColumn fx:id="colPromocaoStatusProduto"
                                                     text="Status do produto"
                                                     prefWidth="140.0"
                                                     sortable="false" />
                                    </columns>

                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="3.0"
                                      minWidth="240.0"
                                      minHeight="58.0"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 10 14 10 14;">

                                    <Label text="Promoções listadas"
                                           styleClass="cartao-texto-secundario" />
                                    <Label fx:id="lblQuantidadePromocoes"
                                           text="0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
