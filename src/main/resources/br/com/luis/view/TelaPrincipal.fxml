<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            stylesheets="@TelaPrincipal.css"
            styleClass="tela-principal"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.TelaPrincipalController">

    <left>
        <VBox minWidth="220.0"
              prefWidth="240.0"
              maxWidth="260.0"
              styleClass="menu-lateral">

            <Label text="MENU PRINCIPAL"
                   styleClass="menu-titulo" />

            <Button fx:id="btnVendas"
                    text="Registrar Venda"
                    onAction="#abrirVendas"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu, botao-menu-destaque" />

            <Button fx:id="btnClientes"
                    text="Clientes"
                    onAction="#abrirClientes"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnProdutos"
                    text="Produtos"
                    onAction="#abrirProdutos"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnPrazosPagamento"
                    text="Prazos de Pagamento"
                    onAction="#abrirPrazosPagamento"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnContasReceber"
                    text="Contas a Receber"
                    onAction="#abrirContasReceber"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnHistoricoVendas"
                    text="Histórico de Vendas"
                    onAction="#abrirHistoricoVendas"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnRelatorios"
                    text="Relatórios"
                    onAction="#abrirRelatorios"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Button fx:id="btnUsuarios"
                    text="Usuários"
                    onAction="#abrirGestaoUsuarios"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnSair"
                    text="Sair"
                    onAction="#sair"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="botao-menu, botao-sair" />
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="area-principal">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0"
                      styleClass="cabecalho-principal">

                    <Label text="Sistema de Gestão Comercial"
                           styleClass="titulo-sistema" />

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_RIGHT"
                          spacing="8.0"
                          styleClass="identificacao-cabecalho">

                        <Label fx:id="lblUsuario"
                               text="Usuário não identificado"
                               styleClass="texto-cabecalho" />

                        <Label text="|"
                               styleClass="separador-cabecalho" />

                        <Label fx:id="lblDataHora"
                               text="--/--/---- --:--:--"
                               styleClass="texto-cabecalho" />
                    </HBox>
                </HBox>
            </top>

            <center>
                <VBox spacing="20.0"
                      styleClass="conteudo-dashboard">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12.0"
                          styleClass="barra-dashboard">

                        <Label text="Visão Geral"
                               styleClass="titulo-dashboard" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Período:"
                               styleClass="rotulo-periodo" />

                        <ComboBox fx:id="cmbPeriodoDashboard"
                                  promptText="Selecione o período"
                                  disable="true"
                                  minWidth="170.0"
                                  prefWidth="190.0"
                                  styleClass="combo-periodo" />

                        <Button fx:id="btnAtualizarDashboard"
                                text="Atualizar"
                                disable="true"
                                styleClass="botao-atualizar" />

                        <StackPane minWidth="28.0"
                                   prefWidth="28.0"
                                   maxWidth="28.0"
                                   minHeight="28.0"
                                   prefHeight="28.0"
                                   maxHeight="28.0"
                                   styleClass="area-carregamento">

                            <ProgressIndicator fx:id="progressoDashboard"
                                               visible="false"
                                               managed="false"
                                               prefWidth="22.0"
                                               prefHeight="22.0"
                                               styleClass="indicador-carregamento" />
                        </StackPane>
                    </HBox>

                    <GridPane hgap="16.0"
                              vgap="16.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              VBox.vgrow="ALWAYS"
                              styleClass="grade-cartoes">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="60.0"
                                               hgrow="ALWAYS"
                                               minWidth="0.0" />
                            <ColumnConstraints percentWidth="40.0"
                                               hgrow="ALWAYS"
                                               minWidth="0.0" />
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints percentHeight="50.0"
                                            vgrow="ALWAYS"
                                            minHeight="150.0" />
                            <RowConstraints percentHeight="50.0"
                                            vgrow="ALWAYS"
                                            minHeight="150.0" />
                        </rowConstraints>

                        <VBox spacing="10.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              styleClass="cartao-dashboard, cartao-principal">

                            <Label text="Vendas do período"
                                   styleClass="cartao-titulo" />

                            <Label fx:id="lblValorTotalVendido"
                                   text="R$ 0,00"
                                   wrapText="true"
                                   styleClass="cartao-valor, cartao-valor-principal" />

                            <Label fx:id="lblQuantidadeVendas"
                                   text="0 vendas"
                                   styleClass="cartao-informacao" />

                            <Region VBox.vgrow="ALWAYS" />

                            <Label fx:id="lblPeriodoConsultado"
                                   text="Período ainda não carregado"
                                   wrapText="true"
                                   styleClass="cartao-texto-secundario" />
                        </VBox>

                        <VBox spacing="12.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              styleClass="cartao-dashboard">

                            <Label text="Recebido no período"
                                   styleClass="cartao-titulo" />

                            <Label fx:id="lblValorRecebidoLiquido"
                                   text="R$ 0,00"
                                   wrapText="true"
                                   styleClass="cartao-valor" />

                            <Region VBox.vgrow="ALWAYS" />

                            <Label text="Líquido, já considerando estornos"
                                   wrapText="true"
                                   styleClass="cartao-texto-secundario" />
                        </VBox>

                        <VBox spacing="12.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1"
                              styleClass="cartao-dashboard">

                            <Label text="Contas a Receber"
                                   styleClass="cartao-titulo" />

                            <GridPane hgap="12.0"
                                      vgap="12.0"
                                      maxWidth="Infinity"
                                      styleClass="grade-contas">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="34.0"
                                                       hgrow="ALWAYS" />
                                    <ColumnConstraints percentWidth="26.0"
                                                       hgrow="ALWAYS" />
                                    <ColumnConstraints percentWidth="40.0"
                                                       hgrow="ALWAYS" />
                                </columnConstraints>

                                <Label text="Situação"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"
                                       styleClass="cabecalho-conta" />

                                <Label text="Quantidade"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"
                                       styleClass="cabecalho-conta" />

                                <Label text="Valor"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"
                                       styleClass="cabecalho-conta" />

                                <Label text="Pendentes"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"
                                       styleClass="rotulo-conta, rotulo-pendente" />

                                <Label fx:id="lblQuantidadeContasPendentes"
                                       text="0 contas"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"
                                       styleClass="quantidade-conta" />

                                <Label fx:id="lblValorTotalPendente"
                                       text="R$ 0,00"
                                       wrapText="true"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1"
                                       styleClass="valor-conta" />

                                <Label text="Vencidas"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"
                                       styleClass="rotulo-conta, rotulo-vencido" />

                                <Label fx:id="lblQuantidadeContasVencidas"
                                       text="0 contas"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"
                                       styleClass="quantidade-conta, quantidade-conta-vencida" />

                                <Label fx:id="lblValorTotalVencido"
                                       text="R$ 0,00"
                                       wrapText="true"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="2"
                                       styleClass="valor-conta, valor-conta-vencida" />
                            </GridPane>
                        </VBox>

                        <VBox spacing="12.0"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              styleClass="cartao-dashboard">

                            <Label text="Estoque Baixo"
                                   styleClass="cartao-titulo" />

                            <Label fx:id="lblQuantidadeProdutosEstoqueBaixo"
                                   text="0 produtos"
                                   styleClass="cartao-valor" />

                            <Region VBox.vgrow="ALWAYS" />

                            <Label text="Abaixo ou no estoque mínimo"
                                   wrapText="true"
                                   styleClass="cartao-texto-secundario" />
                        </VBox>
                    </GridPane>
                </VBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
