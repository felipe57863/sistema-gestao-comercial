<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.TelaPrincipalController">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <left>
                <Label text="Sistema de Gestão Comercial">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Tela Principal Temporária">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <Label text="Navegação temporária para testes" textFill="#555555" />

            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="btnClientes"
                        onAction="#abrirClientes"
                        prefHeight="45.0"
                        prefWidth="160.0"
                        text="Clientes" />

                <Button fx:id="btnProdutos"
                        onAction="#abrirProdutos"
                        prefHeight="45.0"
                        prefWidth="160.0"
                        text="Produtos" />

                <Button fx:id="btnVendas"
                        onAction="#abrirVendas"
                        prefHeight="45.0"
                        prefWidth="160.0"
                        text="Registro de Venda" />

                <Button fx:id="btnContasReceber"
                        onAction="#abrirContasReceber"
                        prefHeight="45.0"
                        prefWidth="160.0"
                        text="Contas a Receber" />

                <Button fx:id="btnSair"
                        onAction="#sair"
                        prefHeight="45.0"
                        prefWidth="160.0"
                        text="Sair" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Label text="Ambiente de desenvolvimento"
               textFill="#777777"
               BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" top="15.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
