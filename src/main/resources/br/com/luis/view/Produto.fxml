<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.ProdutoController">

    <!-- HEADER -->
    <top>
        <BorderPane style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0; -fx-background-color: #f8f9fa;"
                    BorderPane.alignment="CENTER">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </BorderPane.margin>
                    <Button fx:id="btnVoltar" onAction="#onVoltar" prefWidth="90.0" text="Voltar" />
                    <Label text="Cadastro de Produto">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets right="20.0" />
                    </BorderPane.margin>

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- LEFT PANEL: FORM -->
            <VBox prefWidth="450.0" spacing="15.0"
                  style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <Label text="Dados do Produto">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <GridPane vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <children>
                        <Label text="Descrição:*" />
                        <TextField fx:id="txtDescricao"
                                   promptText="Ex: Smartphone Samsung Galaxy"
                                   GridPane.columnIndex="1" />

                        <Label text="Preço:*" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">
                            <children>
                                <Label text="R$" textFill="#555555" />
                                <TextField fx:id="txtPreco"
                                           promptText="Ex: 990,00"
                                           HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Label text="Quantidade em Estoque:*" GridPane.rowIndex="2" />
                        <Spinner fx:id="spnEstoque"
                                 prefWidth="120.0"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="2" />

                        <Label text="Estoque Mínimo:*" GridPane.rowIndex="3" />
                        <Spinner fx:id="spnEstoqueMinimo"
                                 prefWidth="120.0"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="3" />

                        <Label text="Status do Produto:*" GridPane.rowIndex="4" />
                        <ComboBox fx:id="cbStatus"
                                  prefWidth="150.0"
                                  promptText="Ativo"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4" />
                    </children>
                </GridPane>

                <!-- PROMOTION SECTION -->
                <TitledPane animated="false" collapsible="false" text="Promoção (Opcional)">
                    <content>
                        <VBox spacing="15.0">
                            <children>
                                <CheckBox fx:id="chkPromocao" text="Produto em promoção">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </CheckBox>

                                <GridPane vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="10.0" prefWidth="130.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>

                                    <children>
                                        <Label text="Tipo de Desconto:*" />
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" GridPane.columnIndex="1">
                                            <children>
                                                <RadioButton fx:id="rbPercentual" selected="true" text="Percentual">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="tipoDescontoGroup" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="rbFixo" text="Valor Fixo" toggleGroup="$tipoDescontoGroup" />
                                            </children>
                                        </HBox>

                                        <Label text="Valor do Desconto:*" GridPane.rowIndex="1" />
                                        <HBox alignment="CENTER_LEFT"
                                              spacing="5.0"
                                              GridPane.columnIndex="1"
                                              GridPane.rowIndex="1">
                                            <children>
                                                <Label fx:id="lblPrefixoDesconto" text="" />
                                                <TextField fx:id="txtValorDesconto"
                                                           promptText="Ex: 15"
                                                           prefWidth="100.0" />
                                                <Label fx:id="lblSufixoDesconto" text="\%" />
                                            </children>
                                        </HBox>

                                        <Label text="Status da Promoção:" GridPane.rowIndex="2" />
                                        <Label fx:id="lblStatusPromocao"
                                               text="Sem promoção"
                                               textFill="#555555"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                            </children>
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                        </VBox>
                    </content>
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </TitledPane>

                <Region VBox.vgrow="ALWAYS" />

                <!-- FORM BUTTONS -->
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnSalvar"
                                defaultButton="true"
                                onAction="#acaoSalvar"
                                prefHeight="35.0"
                                prefWidth="100.0"
                                text="Salvar" />

                        <Button fx:id="btnCancelar"
                                cancelButton="true"
                                onAction="#acaoCancelar"
                                prefHeight="35.0"
                                prefWidth="100.0"
                                text="Cancelar" />

                        <Button fx:id="btnLimpar"
                                onAction="#acaoLimpar"
                                prefHeight="35.0"
                                prefWidth="100.0"
                                text="Limpar" />
                    </children>
                </HBox>
            </VBox>

            <!-- RIGHT PANEL: LIST -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">

                <!-- TOP ACTIONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnNovo"
                                onAction="#acaoNovo"
                                prefHeight="35.0"
                                prefWidth="90.0"
                                text="Novo" />

                        <Button fx:id="btnExcluir"
                                onAction="#acaoExcluir"
                                prefHeight="35.0"
                                prefWidth="90.0"
                                text="Excluir" />
                    </children>
                </HBox>

                <!-- LIST CONTAINER -->
                <VBox spacing="10.0"
                      style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff;"
                      VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>

                    <children>
                        <Label text="Lista de Produtos">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>

                        <!-- SEARCH BAR -->
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txtBusca"
                                           promptText="Pesquisar produto..."
                                           HBox.hgrow="ALWAYS"
                                           prefHeight="30.0" />

                                <Button fx:id="btnFiltrar"
                                        onAction="#acaoFiltrar"
                                        prefHeight="30.0"
                                        prefWidth="80.0"
                                        text="Filtrar" />
                            </children>
                        </HBox>

                        <!-- TABLE VIEW -->
                        <TableView fx:id="tabelaProdutos"
                                   prefHeight="200.0"
                                   prefWidth="200.0"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="colDescricao" prefWidth="200.0" text="Descrição" />
                                <TableColumn fx:id="colPreco" prefWidth="90.0" text="Preço" />
                                <TableColumn fx:id="colEstoque" prefWidth="75.0" text="Estoque" />
                                <TableColumn fx:id="colPromocao" prefWidth="120.0" text="Promoção" />
                                <TableColumn fx:id="colStatus" prefWidth="75.0" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- PAGINATION MOCK -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button text="&lt;" />
                                <Button style="-fx-background-color: #555555; -fx-text-fill: white;" text="1" />
                                <Button text="2" />
                                <Button text="3" />
                                <Button text="&gt;" />
                            </children>
                        </HBox>

                        <Label fx:id="lblTotalProdutos"
                               alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               text="Total: 0 produtos"
                               textFill="#777777" />
                    </children>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
