<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1180.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.HistoricoVendasController">

    <!-- =========================================================
         CABEÇALHO
         ========================================================= -->
    <top>
        <BorderPane style="-fx-background-color: white;
                           -fx-border-color: #e0e0e0;
                           -fx-border-width: 0 0 1 0;
                           -fx-padding: 15 20 15 20;">

            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar"
                            onAction="#onVoltar"
                            prefWidth="90.0"
                            text="Voltar" />

                    <Label text="Histórico de Vendas">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0"
                        left="20.0"
                        right="20.0"
                        top="20.0" />
            </padding>

            <!-- =================================================
                 FILTROS
                 ================================================= -->
            <VBox spacing="12.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 5;
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 5;
                         -fx-padding: 18;">

                <Label text="Filtros">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="135.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints minWidth="135.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="220.0"
                                           prefWidth="300.0" />

                        <ColumnConstraints minWidth="100.0"
                                           prefWidth="110.0" />

                        <ColumnConstraints minWidth="140.0"
                                           prefWidth="150.0" />

                        <ColumnConstraints minWidth="140.0"
                                           prefWidth="150.0" />
                    </columnConstraints>

                    <Label text="Data inicial:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <Label text="Data final:"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                    <Label text="Cliente ou documento:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0" />

                    <Label text="Venda:"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0" />

                    <Label text="Tipo:"
                           GridPane.columnIndex="4"
                           GridPane.rowIndex="0" />

                    <Label text="Status:"
                           GridPane.columnIndex="5"
                           GridPane.rowIndex="0" />

                    <DatePicker fx:id="dpDataInicial"
                                maxWidth="Infinity"
                                promptText="Data inicial"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1" />

                    <DatePicker fx:id="dpDataFinal"
                                maxWidth="Infinity"
                                promptText="Data final"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />

                    <TextField fx:id="txtClienteDocumento"
                               maxWidth="Infinity"
                               promptText="Nome, CPF ou CNPJ"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1" />

                    <TextField fx:id="txtVendaId"
                               maxWidth="Infinity"
                               promptText="ID"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1" />

                    <ComboBox fx:id="cbTipoVenda"
                              maxWidth="Infinity"
                              promptText="Todos"
                              GridPane.columnIndex="4"
                              GridPane.rowIndex="1" />

                    <ComboBox fx:id="cbStatusVenda"
                              maxWidth="Infinity"
                              promptText="Todos"
                              GridPane.columnIndex="5"
                              GridPane.rowIndex="1" />
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnLimparFiltros"
                            onAction="#onLimparFiltros"
                            prefHeight="35.0"
                            prefWidth="130.0"
                            text="Limpar Filtros" />

                    <Button fx:id="btnFiltrar"
                            onAction="#onFiltrar"
                            prefHeight="35.0"
                            prefWidth="120.0"
                            text="Filtrar" />
                </HBox>
            </VBox>

            <!-- =================================================
                 LISTAGEM E DETALHES
                 ================================================= -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                <!-- =============================================
                     LISTAGEM DE VENDAS
                     ============================================= -->
                <VBox spacing="12.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 5;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 5;
                             -fx-padding: 18;"
                      HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Vendas Encontradas">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnAtualizar"
                                onAction="#onAtualizar"
                                prefHeight="35.0"
                                prefWidth="110.0"
                                text="Atualizar" />
                    </HBox>

                    <TableView fx:id="tabelaVendas"
                               VBox.vgrow="ALWAYS">

                        <columns>
                            <TableColumn fx:id="colVendaId"
                                         minWidth="65.0"
                                         prefWidth="75.0"
                                         text="Venda" />

                            <TableColumn fx:id="colDataHora"
                                         minWidth="125.0"
                                         prefWidth="145.0"
                                         text="Data/Hora" />

                            <TableColumn fx:id="colCliente"
                                         minWidth="160.0"
                                         prefWidth="220.0"
                                         text="Cliente" />

                            <TableColumn fx:id="colTipoVenda"
                                         minWidth="95.0"
                                         prefWidth="110.0"
                                         text="Tipo" />

                            <TableColumn fx:id="colStatusVenda"
                                         minWidth="90.0"
                                         prefWidth="105.0"
                                         text="Status" />

                            <TableColumn fx:id="colValorTotal"
                                         minWidth="105.0"
                                         prefWidth="120.0"
                                         text="Valor" />

                            <TableColumn fx:id="colQuantidadeItens"
                                         minWidth="80.0"
                                         prefWidth="90.0"
                                         text="Produtos" />

                            <TableColumn fx:id="colResumoFinanceiro"
                                         minWidth="145.0"
                                         prefWidth="180.0"
                                         text="Financeiro" />
                        </columns>

                        <placeholder>
                            <Label text="Nenhuma venda encontrada." />
                        </placeholder>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER">
                        <Label fx:id="lblTotalVendas"
                               text="Total: 0 vendas"
                               textFill="#555555" />
                    </HBox>
                </VBox>

                <!-- =============================================
                     DETALHES DA VENDA
                     ============================================= -->
                <VBox minWidth="390.0"
                      prefWidth="430.0"
                      spacing="12.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 5;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 5;
                             -fx-padding: 18;">

                    <Label text="Detalhes da Venda">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>

                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                VBox.vgrow="ALWAYS">

                        <content>
                            <VBox spacing="16.0"
                                  style="-fx-background-color: white;">

                                <!-- DADOS GERAIS -->
                                <VBox spacing="10.0"
                                      style="-fx-border-color: #d1d5db;
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-padding: 12;">

                                    <Label text="Dados gerais">
                                        <font>
                                            <Font name="System Bold"
                                                  size="14.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="10.0" vgap="9.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="125.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label text="Venda:"
                                               GridPane.rowIndex="0" />

                                        <Label fx:id="lblDetalheVendaId"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0" />

                                        <Label text="Data/Hora:"
                                               GridPane.rowIndex="1" />

                                        <Label fx:id="lblDetalheDataHora"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="1" />

                                        <Label text="Tipo:"
                                               GridPane.rowIndex="2" />

                                        <Label fx:id="lblDetalheTipoVenda"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="2" />

                                        <Label text="Status:"
                                               GridPane.rowIndex="3" />

                                        <Label fx:id="lblDetalheStatusVenda"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="3" />

                                        <Label text="Pagamento:"
                                               GridPane.rowIndex="4" />

                                        <Label fx:id="lblDetalheFormaPagamento"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="4" />

                                        <Label text="Valor total:"
                                               GridPane.rowIndex="5" />

                                        <Label fx:id="lblDetalheValorTotal"
                                               text="R$ 0,00"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="5" />
                                    </GridPane>
                                </VBox>

                                <!-- CLIENTE E USUÁRIO -->
                                <VBox spacing="10.0"
                                      style="-fx-border-color: #d1d5db;
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-padding: 12;">

                                    <Label text="Cliente e responsável">
                                        <font>
                                            <Font name="System Bold"
                                                  size="14.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="10.0" vgap="9.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="125.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label text="Cliente:"
                                               GridPane.rowIndex="0" />

                                        <Label fx:id="lblDetalheCliente"
                                               text="—"
                                               wrapText="true"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0" />

                                        <Label text="Documento:"
                                               GridPane.rowIndex="1" />

                                        <Label fx:id="lblDetalheDocumento"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="1" />

                                        <Label text="Usuário:"
                                               GridPane.rowIndex="2" />

                                        <Label fx:id="lblDetalheUsuarioVenda"
                                               text="—"
                                               wrapText="true"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="2" />
                                    </GridPane>
                                </VBox>

                                <!-- FINANCEIRO -->
                                <VBox spacing="10.0"
                                      style="-fx-border-color: #d1d5db;
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-padding: 12;">

                                    <Label text="Financeiro">
                                        <font>
                                            <Font name="System Bold"
                                                  size="14.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="10.0" vgap="9.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="125.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label text="Conta:"
                                               GridPane.rowIndex="0" />

                                        <Label fx:id="lblDetalheContaId"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0" />

                                        <Label text="Status da conta:"
                                               GridPane.rowIndex="1" />

                                        <Label fx:id="lblDetalheStatusConta"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="1" />

                                        <Label text="Valor da conta:"
                                               GridPane.rowIndex="2" />

                                        <Label fx:id="lblDetalheValorConta"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="2" />
                                    </GridPane>

                                    <Label text="Movimentação original:"
                                           textFill="#555555" />

                                    <Label fx:id="lblDetalheMovimentacaoOriginal"
                                           text="—"
                                           wrapText="true" />

                                    <Label text="Movimentação de saída:"
                                           textFill="#555555" />

                                    <Label fx:id="lblDetalheMovimentacaoSaida"
                                           text="—"
                                           wrapText="true" />
                                </VBox>

                                <!-- ESTORNO -->
                                <VBox spacing="10.0"
                                      style="-fx-border-color: #d1d5db;
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-padding: 12;">

                                    <Label text="Auditoria de estorno">
                                        <font>
                                            <Font name="System Bold"
                                                  size="14.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="10.0" vgap="9.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="145.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label text="Auditoria:"
                                               GridPane.rowIndex="0" />

                                        <Label fx:id="lblDetalheAuditoriaId"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0" />

                                        <Label text="Responsável:"
                                               GridPane.rowIndex="1" />

                                        <Label fx:id="lblDetalheUsuarioEstorno"
                                               text="—"
                                               wrapText="true"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="1" />

                                        <Label text="Data/Hora:"
                                               GridPane.rowIndex="2" />

                                        <Label fx:id="lblDetalheDataHoraEstorno"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="2" />

                                        <Label text="Status anterior:"
                                               GridPane.rowIndex="3" />

                                        <Label fx:id="lblDetalheStatusVendaAnterior"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="3" />

                                        <Label text="Conta anterior:"
                                               GridPane.rowIndex="4" />

                                        <Label fx:id="lblDetalheStatusContaAnterior"
                                               text="—"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="4" />
                                    </GridPane>

                                    <Label text="Motivo:"
                                           textFill="#555555" />

                                    <Label fx:id="lblDetalheMotivoEstorno"
                                           text="—"
                                           wrapText="true" />
                                </VBox>

                                <!-- ITENS -->
                                <VBox spacing="10.0"
                                      style="-fx-border-color: #d1d5db;
                                             -fx-border-radius: 5;
                                             -fx-background-radius: 5;
                                             -fx-padding: 12;">

                                    <Label text="Produtos da venda">
                                        <font>
                                            <Font name="System Bold"
                                                  size="14.0" />
                                        </font>
                                    </Label>

                                    <TableView fx:id="tabelaItensVenda"
                                               minHeight="170.0"
                                               prefHeight="210.0">

                                        <columns>
                                            <TableColumn fx:id="colItemProdutoId"
                                                         minWidth="55.0"
                                                         prefWidth="65.0"
                                                         text="ID" />

                                            <TableColumn fx:id="colItemDescricao"
                                                         minWidth="145.0"
                                                         prefWidth="190.0"
                                                         text="Produto" />

                                            <TableColumn fx:id="colItemQuantidade"
                                                         minWidth="60.0"
                                                         prefWidth="75.0"
                                                         text="Qtd." />

                                            <TableColumn fx:id="colItemPrecoUnitario"
                                                         minWidth="85.0"
                                                         prefWidth="105.0"
                                                         text="Preço" />

                                            <TableColumn fx:id="colItemSubtotal"
                                                         minWidth="85.0"
                                                         prefWidth="105.0"
                                                         text="Subtotal" />
                                        </columns>

                                        <placeholder>
                                            <Label text="Selecione uma venda." />
                                        </placeholder>

                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <HBox alignment="CENTER">
                        <Button fx:id="btnEstornarVenda"
                                disable="true"
                                onAction="#onEstornarVenda"
                                prefHeight="36.0"
                                prefWidth="170.0"
                                text="Estornar Venda" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>