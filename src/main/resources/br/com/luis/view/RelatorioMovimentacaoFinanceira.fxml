<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.RelatorioMovimentacaoFinanceiraController"
            prefWidth="1180.0"
            prefHeight="720.0"
            stylesheets="@TelaPrincipal.css"
            style="-fx-background-color: #f4f6f9;"
            styleClass="tela-principal">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;"
                    styleClass="cabecalho-principal">

            <left>
                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <Button fx:id="btnVoltar"
                            text="Voltar"
                            prefWidth="90.0"
                            onAction="#onVoltar" />

                    <Label text="Relatório de Movimentações Financeiras"
                           styleClass="titulo-sistema" />
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT"
                      spacing="8.0"
                      styleClass="identificacao-cabecalho">

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           styleClass="texto-cabecalho" />

                    <Label text="|"
                           styleClass="separador-cabecalho" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           styleClass="texto-cabecalho" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox spacing="14.0"
              style="-fx-background-color: #f4f6f9;">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <VBox spacing="10.0"
                  maxWidth="Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 16;">

                <Label text="Filtros"
                       styleClass="cartao-titulo" />

                <GridPane hgap="12.0"
                          vgap="7.0"
                          maxWidth="Infinity">

                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="130.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="130.0"
                                           prefWidth="145.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="135.0"
                                           prefWidth="150.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="210.0"
                                           prefWidth="245.0" />

                        <ColumnConstraints hgrow="ALWAYS"
                                           minWidth="150.0"
                                           prefWidth="170.0" />
                    </columnConstraints>

                    <Label text="Data inicial:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"
                           styleClass="rotulo-periodo" />

                    <Label text="Data final:"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"
                           styleClass="rotulo-periodo" />

                    <Label text="Tipo:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"
                           styleClass="rotulo-periodo" />

                    <Label text="Origem:"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"
                           styleClass="rotulo-periodo" />

                    <Label text="Forma de pagamento:"
                           GridPane.columnIndex="4"
                           GridPane.rowIndex="0"
                           styleClass="rotulo-periodo" />

                    <DatePicker fx:id="dpDataInicial"
                                maxWidth="Infinity"
                                prefHeight="34.0"
                                prefWidth="145.0"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1" />

                    <DatePicker fx:id="dpDataFinal"
                                maxWidth="Infinity"
                                prefHeight="34.0"
                                prefWidth="145.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />

                    <ComboBox fx:id="cbTipoMovimentacao"
                              maxWidth="Infinity"
                              prefHeight="34.0"
                              prefWidth="150.0"
                              GridPane.columnIndex="2"
                              GridPane.rowIndex="1" />

                    <ComboBox fx:id="cbOrigemMovimentacao"
                              maxWidth="Infinity"
                              prefHeight="34.0"
                              prefWidth="245.0"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="1" />

                    <ComboBox fx:id="cbFormaPagamento"
                              maxWidth="Infinity"
                              prefHeight="34.0"
                              prefWidth="170.0"
                              GridPane.columnIndex="4"
                              GridPane.rowIndex="1" />
                </GridPane>

                <HBox alignment="CENTER_LEFT"
                      minHeight="35.0"
                      spacing="10.0">

                    <StackPane minWidth="28.0"
                               prefWidth="28.0"
                               maxWidth="28.0"
                               minHeight="28.0"
                               prefHeight="28.0"
                               maxHeight="28.0"
                               styleClass="area-carregamento">

                        <ProgressIndicator fx:id="progressoRelatorio"
                                           visible="false"
                                           managed="false"
                                           prefWidth="22.0"
                                           prefHeight="22.0"
                                           styleClass="indicador-carregamento" />
                    </StackPane>

                    <Label fx:id="lblEstadoConsulta"
                           text="Relatório pronto para consulta."
                           wrapText="true"
                           styleClass="cartao-texto-secundario" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnLimparFiltros"
                            text="Limpar"
                            prefHeight="35.0"
                            prefWidth="100.0"
                            onAction="#onLimparFiltros" />

                    <Button fx:id="btnFiltrar"
                            text="Filtrar"
                            disable="true"
                            prefHeight="35.0"
                            prefWidth="100.0"
                            onAction="#onFiltrar"
                            styleClass="botao-atualizar" />
                </HBox>
            </VBox>

            <VBox spacing="10.0"
                  maxWidth="Infinity"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 16;">

                <Label text="Movimentações encontradas"
                       styleClass="cartao-titulo" />

                <TableView fx:id="tabelaMovimentacoes"
                           minHeight="260.0"
                           maxWidth="Infinity"
                           maxHeight="Infinity"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colMovimentacaoId"
                                     text="Movimento"
                                     prefWidth="80.0"
                                     sortable="false" />

                        <TableColumn fx:id="colDataHora"
                                     text="Data/Hora"
                                     prefWidth="155.0"
                                     sortable="false" />

                        <TableColumn fx:id="colTipo"
                                     text="Tipo"
                                     prefWidth="85.0"
                                     sortable="false" />

                        <TableColumn fx:id="colOrigem"
                                     text="Origem"
                                     prefWidth="210.0"
                                     sortable="false" />

                        <TableColumn fx:id="colFormaPagamento"
                                     text="Pagamento"
                                     prefWidth="105.0"
                                     sortable="false" />

                        <TableColumn fx:id="colValor"
                                     text="Valor"
                                     prefWidth="110.0"
                                     sortable="false" />

                        <TableColumn fx:id="colVendaId"
                                     text="Venda"
                                     prefWidth="70.0"
                                     sortable="false" />

                        <TableColumn fx:id="colContaReceberId"
                                     text="Conta"
                                     prefWidth="75.0"
                                     sortable="false" />

                        <TableColumn fx:id="colResponsavel"
                                     text="Responsável"
                                     prefWidth="230.0"
                                     sortable="false" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblFiltroAplicado"
                       text=""
                       wrapText="true"
                       styleClass="cartao-texto-secundario" />
            </VBox>

            <GridPane hgap="12.0"
                      maxWidth="Infinity">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                </columnConstraints>

                <VBox spacing="4.0"
                      minHeight="72.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;"
                      GridPane.columnIndex="0">

                    <Label text="Movimentações"
                           styleClass="cartao-texto-secundario" />

                    <Label fx:id="lblQuantidadeMovimentacoes"
                           text="0 movimentações"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>

                <VBox spacing="4.0"
                      minHeight="72.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;"
                      GridPane.columnIndex="1">

                    <Label text="Entradas"
                           styleClass="cartao-texto-secundario" />

                    <Label fx:id="lblTotalEntradas"
                           text="R$ 0,00"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>

                <VBox spacing="4.0"
                      minHeight="72.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;"
                      GridPane.columnIndex="2">

                    <Label text="Saídas"
                           styleClass="cartao-texto-secundario" />

                    <Label fx:id="lblTotalSaidas"
                           text="R$ 0,00"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>

                <VBox spacing="4.0"
                      minHeight="72.0"
                      maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14 16 14 16;"
                      GridPane.columnIndex="3">

                    <Label text="Líquido"
                           styleClass="cartao-texto-secundario" />

                    <Label fx:id="lblResultadoLiquido"
                           text="R$ 0,00"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #344253;" />
                </VBox>
            </GridPane>
        </VBox>
    </center>
</BorderPane>
