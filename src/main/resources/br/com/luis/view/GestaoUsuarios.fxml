<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.GestaoUsuariosController">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar"
                            onAction="#onVoltar"
                            prefWidth="90.0"
                            text="Voltar" />
                    <Label text="Gestão de Usuários">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button fx:id="btnAlterarMinhaSenha"
                            onAction="#abrirAlteracaoMinhaSenha"
                            text="Alterar Minha Senha" />

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox style="-fx-padding: 20;">
            <TabPane tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS">
                <tabs>
                <Tab text="Usuários cadastrados">
                    <BorderPane style="-fx-padding: 18;">
                        <center>
                            <TableView fx:id="tabelaUsuarios">
                                <columns>
                                    <TableColumn fx:id="colId"
                                                 prefWidth="60.0"
                                                 text="ID" />
                                    <TableColumn fx:id="colNome"
                                                 prefWidth="250.0"
                                                 text="Nome" />
                                    <TableColumn fx:id="colLogin"
                                                 prefWidth="180.0"
                                                 text="Login" />
                                    <TableColumn fx:id="colPerfil"
                                                 prefWidth="110.0"
                                                 text="Perfil" />
                                    <TableColumn fx:id="colStatus"
                                                 prefWidth="110.0"
                                                 text="Status" />
                                    <TableColumn fx:id="colTrocaObrigatoria"
                                                 prefWidth="150.0"
                                                 text="Troca obrigatória" />
                                </columns>
                                <placeholder>
                                    <Label text="Nenhum usuário encontrado." />
                                </placeholder>
                            </TableView>
                        </center>

                        <bottom>
                            <HBox alignment="CENTER_RIGHT"
                                  spacing="10.0"
                                  style="-fx-padding: 14 0 0 0;">
                                <Button fx:id="btnAtualizarLista"
                                        onAction="#atualizarLista"
                                        text="Atualizar Lista" />
                                <Button fx:id="btnAlterarStatus"
                                        disable="true"
                                        onAction="#alterarStatusSelecionado"
                                        text="Ativar / Inativar" />
                                <Button fx:id="btnRedefinirSenha"
                                        disable="true"
                                        onAction="#abrirRedefinicaoSenha"
                                        text="Redefinir Senha" />
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>

                <Tab text="Cadastrar usuário">
                    <VBox alignment="TOP_CENTER"
                          spacing="16.0"
                          style="-fx-padding: 28;">
                        <VBox maxWidth="620.0"
                              spacing="14.0"
                              style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #d8dee6; -fx-border-radius: 7; -fx-padding: 24;">
                            <Label text="Novo usuário">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>

                            <GridPane hgap="12.0" vgap="12.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="160.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                </columnConstraints>

                                <Label text="Nome:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0" />
                                <TextField fx:id="txtNome"
                                           promptText="Nome completo"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0" />

                                <Label text="Login:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1" />
                                <TextField fx:id="txtLogin"
                                           promptText="Login de acesso"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1" />

                                <Label text="Perfil:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2" />
                                <ComboBox fx:id="cmbPerfil"
                                          maxWidth="Infinity"
                                          promptText="Selecione o perfil"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="2" />

                                <Label text="Senha temporária:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="3" />
                                <PasswordField fx:id="txtSenhaTemporaria"
                                               promptText="Mínimo de 8 caracteres"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="3" />

                                <Label text="Confirmação:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="4" />
                                <PasswordField fx:id="txtConfirmacao"
                                               promptText="Repita a senha temporária"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="4" />
                            </GridPane>

                            <Label text="O novo usuário será criado como ATIVO e deverá trocar a senha no primeiro acesso."
                                   wrapText="true"
                                   style="-fx-text-fill: #5f6b7a;" />

                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <Button fx:id="btnLimpar"
                                        onAction="#limparFormulario"
                                        text="Limpar" />
                                <Button fx:id="btnCadastrar"
                                        defaultButton="true"
                                        onAction="#cadastrarUsuario"
                                        style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                                        text="Cadastrar" />
                            </HBox>
                        </VBox>
                    </VBox>
                </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
