<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1180.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.luis.controller.GestaoUsuariosController">

    <top>
        <BorderPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <left>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="btnVoltar"
                            onAction="#onVoltar"
                            prefWidth="90.0"
                            text="Voltar" />

                    <Label text="Gestão de Usuários">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </HBox>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button fx:id="btnAlterarMinhaSenha"
                            onAction="#abrirAlteracaoMinhaSenha"
                            prefHeight="32.0"
                            text="Alterar Minha Senha" />

                    <Label fx:id="lblUsuario"
                           text="Usuário não identificado"
                           textFill="#555555" />

                    <Label text="|" textFill="#777777" />

                    <Label fx:id="lblDataHora"
                           text="--/--/---- --:--:--"
                           textFill="#555555" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox style="-fx-padding: 20;">
            <VBox spacing="14.0"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;"
                  VBox.vgrow="ALWAYS">

                <TabPane tabClosingPolicy="UNAVAILABLE"
                         style="-fx-background-color: white;"
                         styleClass="floating"
                         VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Usuários cadastrados">
                            <VBox spacing="14.0"
                                  style="-fx-background-color: white; -fx-padding: 18;">

                                <VBox spacing="10.0"
                                      style="-fx-background-color: #f8f9fa; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 14;">
                                    <Label text="Consulta de usuários">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="12.0" vgap="7.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS"
                                                               minWidth="260.0"
                                                               prefWidth="430.0" />
                                            <ColumnConstraints minWidth="130.0"
                                                               prefWidth="150.0" />
                                            <ColumnConstraints minWidth="130.0"
                                                               prefWidth="150.0" />
                                            <ColumnConstraints minWidth="150.0"
                                                               prefWidth="170.0" />
                                        </columnConstraints>

                                        <Label text="Pesquisar por nome ou login:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="0" />
                                        <Label text="Perfil:"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0" />
                                        <Label text="Status:"
                                               GridPane.columnIndex="2"
                                               GridPane.rowIndex="0" />
                                        <Label text="Troca obrigatória:"
                                               GridPane.columnIndex="3"
                                               GridPane.rowIndex="0" />

                                        <TextField fx:id="txtPesquisaUsuario"
                                                   maxWidth="Infinity"
                                                   prefHeight="34.0"
                                                   promptText="Digite o nome ou login"
                                                   GridPane.columnIndex="0"
                                                   GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbFiltroPerfil"
                                                  maxWidth="Infinity"
                                                  prefHeight="34.0"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbFiltroStatus"
                                                  maxWidth="Infinity"
                                                  prefHeight="34.0"
                                                  GridPane.columnIndex="2"
                                                  GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbFiltroTrocaObrigatoria"
                                                  maxWidth="Infinity"
                                                  prefHeight="34.0"
                                                  GridPane.columnIndex="3"
                                                  GridPane.rowIndex="1" />
                                    </GridPane>

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button onAction="#limparFiltros"
                                                prefHeight="35.0"
                                                prefWidth="130.0"
                                                text="Limpar Filtros" />
                                        <Button onAction="#aplicarFiltros"
                                                prefHeight="35.0"
                                                prefWidth="100.0"
                                                text="Filtrar" />
                                    </HBox>
                                </VBox>

                                <TableView fx:id="tabelaUsuarios"
                                           VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId"
                                                     minWidth="55.0"
                                                     prefWidth="65.0"
                                                     text="ID" />
                                        <TableColumn fx:id="colNome"
                                                     minWidth="180.0"
                                                     prefWidth="300.0"
                                                     text="Nome" />
                                        <TableColumn fx:id="colLogin"
                                                     minWidth="140.0"
                                                     prefWidth="220.0"
                                                     text="Login" />
                                        <TableColumn fx:id="colPerfil"
                                                     minWidth="95.0"
                                                     prefWidth="125.0"
                                                     text="Perfil" />
                                        <TableColumn fx:id="colStatus"
                                                     minWidth="95.0"
                                                     prefWidth="125.0"
                                                     text="Status" />
                                        <TableColumn fx:id="colTrocaObrigatoria"
                                                     minWidth="135.0"
                                                     prefWidth="165.0"
                                                     text="Troca obrigatória" />
                                    </columns>

                                    <placeholder>
                                        <Label text="Nenhum usuário encontrado." />
                                    </placeholder>

                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="lblTotalUsuarios"
                                           style="-fx-font-weight: bold;"
                                           text="Total de usuários: 0"
                                           textFill="#555555" />

                                    <Region HBox.hgrow="ALWAYS" />

                                    <Button fx:id="btnAtualizarLista"
                                            onAction="#atualizarLista"
                                            prefHeight="35.0"
                                            prefWidth="125.0"
                                            text="Atualizar Lista" />
                                    <Button fx:id="btnEditarUsuario"
                                            disable="true"
                                            onAction="#abrirEdicaoUsuario"
                                            prefHeight="35.0"
                                            prefWidth="100.0"
                                            text="Editar" />
                                    <Button fx:id="btnAlterarStatus"
                                            disable="true"
                                            onAction="#alterarStatusSelecionado"
                                            prefHeight="35.0"
                                            prefWidth="145.0"
                                            text="Ativar / Inativar" />
                                    <Button fx:id="btnRedefinirSenha"
                                            disable="true"
                                            onAction="#abrirRedefinicaoSenha"
                                            prefHeight="35.0"
                                            prefWidth="145.0"
                                            text="Redefinir Senha" />
                                </HBox>
                            </VBox>
                        </Tab>

                        <Tab text="Cadastrar usuário">
                            <VBox alignment="TOP_CENTER"
                                  spacing="16.0"
                                  style="-fx-background-color: #f4f6f9; -fx-padding: 24;">
                                <VBox maxWidth="720.0"
                                      spacing="16.0"
                                      style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 22;">
                                    <Label text="Novo usuário">
                                        <font>
                                            <Font name="System Bold" size="16.0" />
                                        </font>
                                    </Label>

                                    <GridPane hgap="12.0" vgap="14.0">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="175.0" />
                                            <ColumnConstraints hgrow="ALWAYS"
                                                               minWidth="300.0"
                                                               prefWidth="470.0" />
                                        </columnConstraints>

                                        <Label text="Nome:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="0" />
                                        <TextField fx:id="txtNome"
                                                   maxWidth="Infinity"
                                                   prefHeight="34.0"
                                                   promptText="Nome completo"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0" />

                                        <Label text="Login:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1" />
                                        <TextField fx:id="txtLogin"
                                                   maxWidth="Infinity"
                                                   prefHeight="34.0"
                                                   promptText="Login de acesso"
                                                   GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1" />

                                        <Label text="Perfil:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cmbPerfil"
                                                  maxWidth="Infinity"
                                                  prefHeight="34.0"
                                                  promptText="Selecione o perfil"
                                                  GridPane.columnIndex="1"
                                                  GridPane.rowIndex="2" />

                                        <Label text="Senha temporária:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="3" />
                                        <PasswordField fx:id="txtSenhaTemporaria"
                                                       maxWidth="Infinity"
                                                       prefHeight="34.0"
                                                       promptText="Mínimo de 8 caracteres"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="3" />

                                        <Label text="Confirmação:"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="4" />
                                        <PasswordField fx:id="txtConfirmacao"
                                                       maxWidth="Infinity"
                                                       prefHeight="34.0"
                                                       promptText="Repita a senha temporária"
                                                       GridPane.columnIndex="1"
                                                       GridPane.rowIndex="4" />
                                    </GridPane>

                                    <Label text="O novo usuário será criado como ATIVO e deverá trocar a senha no primeiro acesso."
                                           wrapText="true"
                                           style="-fx-text-fill: #5f6b7a;" />

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="btnLimpar"
                                                onAction="#limparFormulario"
                                                prefHeight="35.0"
                                                prefWidth="100.0"
                                                text="Limpar" />
                                        <Button fx:id="btnCadastrar"
                                                defaultButton="true"
                                                onAction="#cadastrarUsuario"
                                                prefHeight="35.0"
                                                prefWidth="110.0"
                                                style="-fx-background-color: #2c7be5; -fx-text-fill: white;"
                                                text="Cadastrar" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
